# Optional environment settings; copy values into your shell before running.
export RV1126B_SERVER='https://botstation.shengwang.cn/api'
export MYBOT_KV_STORE_DIR='/userdata/mybot-rv1126b'
export RV1126B_INPUT_DEVICE='auto'
export RV1126B_TOUCH_DEVICE='auto'
# Optional: choose a station interface; empty discovers an existing wireless interface.
export RV1126B_WIFI_INTERFACE=''
# Wait for plausible system time after network readiness (1..300 seconds).
export RV1126B_TIME_SYNC_TIMEOUT='30'
# Existing system time services remain the default. To explicitly enable the
# bundled BusyBox one-shot helper, set an absolute path inside the extracted package:
# export RV1126B_TIME_SYNC_HELPER='/userdata/mybot-rv1126b-0.3.3-aarch64/assets/time/sync-busybox.sh'
# export RV1126B_NTP_SERVER='pool.ntp.org'
# Set RV1126B_VIDEO=1 to select the video executable.
# Set RV1126B_DEVICE_ID only when an explicit identity is intended.
# MYBOT_LOCALE selects prompts; the supplied UI language is built as zh-CN.
