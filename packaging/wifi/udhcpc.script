#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Private per-interface udhcpc hook. Never flush addresses or replace default routes.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077
runtime=${MYBOT_WIFI_RUNTIME:?missing private runtime directory}
station=${MYBOT_WIFI_INTERFACE:?missing owned station interface}
case "$station" in ''|*[!a-zA-Z0-9_.-]*) exit 1 ;; esac
case "$runtime" in /*) ;; *) exit 1 ;; esac
[ -d "$runtime" ] && [ ! -L "$runtime" ] || exit 1
[ "${interface:-$station}" = "$station" ] || exit 1

ipv4() {
    awk -v address="$1" 'BEGIN {
        n=split(address,a,"."); if(n!=4) exit 1;
        for(i=1;i<=4;i++) if(a[i]!~/^[0-9]+$/ || a[i]+0>255 || length(a[i])>3) exit 1;
        exit 0;
    }'
}

restore_dns() {
    # Restore only if no other service has replaced or modified our last write.
    if [ -f "$runtime/resolv.original" ] && [ -f "$runtime/resolv.owned" ] &&
       [ -f /etc/resolv.conf ] && [ ! -L /etc/resolv.conf ] &&
       cmp -s /etc/resolv.conf "$runtime/resolv.owned"; then
        temporary=/etc/.mybot-wifi-resolv.$$
        if cp -p "$runtime/resolv.original" "$temporary"; then
            mv -f "$temporary" /etc/resolv.conf || rm -f "$temporary"
        fi
    fi
    rm -f "$runtime/resolv.original" "$runtime/resolv.owned"
}

remove_lease() {
    rm -f "$runtime/lease.ready"
    if [ -f "$runtime/route.owned" ]; then
        gateway=$(cat "$runtime/route.owned")
        if ipv4 "$gateway"; then
            ip -4 route del default via "$gateway" dev "$station" metric 42760 2>/dev/null || :
        fi
        rm -f "$runtime/route.owned"
    fi
    if [ -f "$runtime/address.owned" ]; then
        address=$(cat "$runtime/address.owned")
        case "$address" in *[!0-9./]*) ;; *)
            ip -4 address del "$address" dev "$station" 2>/dev/null || :
        esac
        rm -f "$runtime/address.owned"
    fi
}

case "${1:-}" in
    deconfig|mybot-cleanup)
        remove_lease
        restore_dns
        exit 0
        ;;
    bound|renew) ;;
    *) exit 0 ;;
esac

ipv4 "${ip:-}" && ipv4 "${subnet:-}" || exit 1
prefix=$(awk -v mask="$subnet" 'BEGIN {
    split(mask,a,"."); bits=0; ended=0;
    for(i=1;i<=4;i++) {
        b=a[i]+0; n=0;
        if(b==255) n=8; else if(b==254) n=7; else if(b==252) n=6;
        else if(b==248) n=5; else if(b==240) n=4; else if(b==224) n=3;
        else if(b==192) n=2; else if(b==128) n=1; else if(b!=0) exit 1;
        if(ended && n) exit 1;
        bits+=n; if(n<8) ended=1;
    }
    if(bits<1 || bits>32) exit 1; print bits;
}') || exit 1
# DHCP data is untrusted input. Ignore all but the first valid router and DNS addresses.
gateway=
for candidate in ${router:-}; do
    if ipv4 "$candidate"; then gateway=$candidate; break; fi
done
[ -n "$gateway" ] || exit 1
remove_lease
address=$ip/$prefix
if ip -4 address add "$address" dev "$station" 2>/dev/null; then
    printf '%s\n' "$address" > "$runtime/address.owned"
fi
if ip -4 route add default via "$gateway" dev "$station" metric 42760 2>/dev/null; then
    printf '%s\n' "$gateway" > "$runtime/route.owned"
fi
# A DHCP lease must have the actual address and a route on the station interface.
ip -4 address show dev "$station" | awk -v expected="$address" \
    '$1=="inet" && $2==expected {found=1} END {exit !found}' || exit 1
ip -4 route show default dev "$station" | awk 'END {exit NR==0}' || exit 1

: > "$runtime/resolv.next"
for candidate in ${dns:-}; do
    if ipv4 "$candidate"; then printf 'nameserver %s\n' "$candidate" >> "$runtime/resolv.next"; fi
done
# Symlinked resolvers belong to another network manager and are left under its control.
# A preconfigured resolver remains usable when this hook cannot own resolv.conf.
if [ -s "$runtime/resolv.next" ] && [ -f /etc/resolv.conf ] &&
   [ ! -L /etc/resolv.conf ] && [ -w /etc/resolv.conf ]; then
    if [ ! -f "$runtime/resolv.original" ]; then
        cp -p /etc/resolv.conf "$runtime/resolv.original"
    elif [ -f "$runtime/resolv.owned" ] && ! cmp -s /etc/resolv.conf "$runtime/resolv.owned"; then
        # Another manager took ownership. Do not overwrite its newer DNS configuration.
        rm -f "$runtime/resolv.original" "$runtime/resolv.owned" "$runtime/resolv.next"
        : > "$runtime/lease.ready"
        exit 0
    fi
    temporary=/etc/.mybot-wifi-resolv.$$
    if cp -p /etc/resolv.conf "$temporary" && cat "$runtime/resolv.next" > "$temporary"; then
        if mv -f "$temporary" /etc/resolv.conf; then
            cp "$runtime/resolv.next" "$runtime/resolv.owned"
        else
            rm -f "$temporary"
        fi
    fi
fi
rm -f "$runtime/resolv.next"
: > "$runtime/lease.ready"
